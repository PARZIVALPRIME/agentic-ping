# Agentic GraphRAG Hackathon — Environment Configuration
# Copy this file to .env and fill in your values

# === TigerGraph (optional graph backend; unset = the local JSON graph) ===
# TG_ENABLED=true makes the agent's graph tools answer from TigerGraph; the
# corpus-built local graph is still kept as a mirror, every remote answer is
# verified against it, and any outage degrades back to it with a printed reason.
#   python tools/tg_ingest.py --status           # what the server has now
#   python tools/tg_ingest.py --install --push   # schema + queries + corpus graph
# Offline (no TigerGraph install): python tools/tg_fake_server.py --port 19123
TG_ENABLED=
# Cloud (Savanna) form - the GSQL port is closed there, use tools/tg_ingest.py --print
TG_HOST=https://YOUR_INSTANCE.i.tgcloud.io
TG_GRAPHNAME=OlympicsKG
TG_USERNAME=tigergraph
TG_PASSWORD=tigergraph
TG_RESTPP_PORT=443
TG_GS_PORT=443
# Community Edition form: TG_HOST=http://localhost TG_RESTPP_PORT=9000 TG_GS_PORT=14240
# Optional:
TG_TOKEN=
# Row budget per query - a safety valve, NOT a tuning knob. The corpus's largest
# candidate set is 2210 rows (probe: python tools/probe_tg_semantics.py); a budget
# below it turns into a loud "row budget" note instead of silent truncation.
TG_MAX_ROWS=100000
TG_TIMEOUT=30
TG_RETRIES=2


# === LLM Provider: Groq ===
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_YOUR_KEY_HERE

# ---------------------------------------------------------------------------
# ALTERNATIVE: local 4B model via Ollama (no key, no quota, nothing leaves the
# box). To use it, comment out the two Groq lines above and uncomment this
# block. `ollama serve` must already be running - startup pings the daemon and
# refuses to report available=True if it is not, so a dead server shows up as a
# loud warning instead of 150 silently-deterministic questions.
#
#   ollama pull qwen3:4b
#   ollama serve
#   python preflight.py            # must print the model name, not "none"
#
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# CHAT_MODEL=qwen3:4b
# COMPLETION_MODEL=qwen3:4b
# EVAL_MODEL=qwen3:4b
# FAST_MODEL=qwen3:4b
# LLM_REASONING_EFFORT=none         # thinking disabled: JSON returns valid schema
# LLM_TEMPERATURE=0.3               # exploration: temperature 0 makes every
#                                   # investigation take the same path
# LLM_EVAL_TEMPERATURE=0.0          # judging/verification stays greedy
# LLM_MAX_TOKENS=1200
# LLM_MIN_INTERVAL_S=0            # local server has no rate limit to pace
# LLM_TPM=0
#
# AGENT_MODE=plan
#   Use `plan`, not `hybrid`/`react`, on a 4B model. ReAct needs reliable native
#   tool-calling; below ~7B the loop burns its step budget and returns "". In
#   `plan` mode the deterministic planner drives and the model is used only
#   where it cannot lose: judging free-text equivalence and adjudicating
#   lookup-type answers. Aggregation/superlative adjudication is skipped by
#   design (utils/llm.py::refine_answer) because a count over 60+ enumerated
#   events cannot be validly checked against the handful of passages that fit
#   in the prompt.
# ---------------------------------------------------------------------------

# === Rate limiting (important for long benchmark runs) ===
# Free/on-demand tiers return HTTP 429 when pushed. Instead of retry-thrashing,
# we pace request starts client-side. 1.5s ≈ 40 requests/min; 0 disables pacing.
LLM_MIN_INTERVAL_S=1.5
# Hard caps so one unlucky call can never stall a whole run.
LLM_MAX_BACKOFF_S=20
LLM_MAX_CALL_S=90
# Token budget per minute. Groq's free tier meters TOKENS (gpt-oss-120b:
# 30 RPM, 1K RPD, 8K TPM, 200K TPD). The ReAct agent re-sends the system prompt
# plus tool schemas (~1.4k tokens) on every step, so the token budget, not the
# request count, is what binds. 0 disables token pacing.
LLM_TPM=8000
LLM_OUTPUT_RESERVE=250
# Circuit breaker: after N consecutive 429s the provider is skipped entirely and
# the deterministic layer finishes the question instead of stalling the run.
LLM_CIRCUIT_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_S=60

# === Agentic loop ===
# AGENT_MODE: react  = the LLM drives every step via native tool calls
#             hybrid = the LLM drives; deterministic solvers rescue empty answers
#             plan   = deterministic planner/executor only
AGENT_MODE=hybrid
# How a question becomes a QuerySpec (the slot parse):
#   semantic (default) - reasoning/query_parser.parse_question_semantic: the LLM
#                        extracts the slots; the template parser validates each
#                        model slot against the corpus and fills only what the
#                        model left empty. Every decision is recorded on the run
#                        (metadata.parse_report) and shown in the dashboard.
#   rules              - the template parser alone (ablation / regression runs on
#                        the deterministic path).
PARSE_MODE=semantic
AGENT_REACT_MAX_STEPS=10
AGENT_REACT_RETRIES=2
AGENT_MAX_STEPS=15
AGENT_CONFIDENCE_THRESHOLD=0.9
AGENT_STALE_STEP_LIMIT=2
AGENT_MAX_WIDEN_ATTEMPTS=2

# === Model Selection (Groq) ===
# Available on a standard Groq key: openai/gpt-oss-120b, openai/gpt-oss-20b,
# qwen/qwen3.8-27b, groq/compound. Check with: python tools/probe_llm.py <key>
COMPLETION_MODEL=openai/gpt-oss-120b
CHAT_MODEL=openai/gpt-oss-120b
EVAL_MODEL=openai/gpt-oss-120b
FAST_MODEL=openai/gpt-oss-20b

# Generation budget. NOTE: the published Groq run was produced at
# LLM_TEMPERATURE=0.0 / LLM_MAX_TOKENS=900; the values below are the ones the
# agentic runtime should use (see config.py:120-130 for why temperature > 0).
LLM_TEMPERATURE=0.3
LLM_EVAL_TEMPERATURE=0.0
LLM_MAX_TOKENS=1200
LLM_REASONING_EFFORT=low

# === Local Embeddings (sentence-transformers on GPU) ===
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cuda

# === Paths ===
CORPUS_PATH=corpus-20260919T043338Z-1-001/corpus/corpus.jsonl
PUBLIC_QUESTIONS_PATH=questions-20260919T043312Z-1-001/questions/eval_public.jsonl
HIDDEN_QUESTIONS_PATH=questions-20260919T043312Z-1-001/questions/eval_hidden.jsonl
RESULTS_DIR=results
# The corpus-built graph is cached here and reused by every pipeline (and by a
# TigerGraph run as its local mirror). Delete it to force a rebuild.
KG_CACHE_PATH=results/knowledge_graph.json
# REBUILD_KG=1 forces a rebuild even when the cache file exists.
REBUILD_KG=

# === Retrieval ===
# auto         - neural sentence-transformers when the model is available, else
#                the sparse index (what a GPU run uses)
# sparse-tfidf - exact, deterministic, no model download (what --no-llm runs use)
# hashing-tfidf- no model and no corpus statistics, for a genuinely foreign corpus
VECTOR_BACKEND=auto
RETRIEVAL_TOP_K=10
RAG_TOP_K=5
RETRIEVAL_NUM_HOPS=2

# === Corpus domain (what the corpus is about; never hardcoded in prompts) ===
CORPUS_LABEL=a corpus of sports-event articles
CORPUS_ENTITY_LABEL=Olympic event
GRAPH_NAME=OlympicsKG
# Plausible range for a year a question may mention. A value outside it is
# rejected as a hallucinated slot instead of reaching a solver.
CORPUS_YEAR_MIN=1896
CORPUS_YEAR_MAX=2035

# === Calibrated thresholds (utils/thresholds.py) ===
# Every match score the deterministic layer uses is set here rather than in code.
# Each has a default; set one only to re-calibrate against your own corpus.
# THRESH_SPORT_MATCH_MIN=0.72        # question sport -> graph sport
# THRESH_VENUE_MATCH_MIN=0.72        # question venue -> graph venue
# THRESH_VENUE_MATCH_BAND=0.06       # how close two venues may score before it is ambiguous
# THRESH_TITLE_MATCH_MIN=0.85        # lookup question title -> article title
# THRESH_CLASSIFIER_MIN_OVERRIDE=0.6 # confidence a model needs to overrule a template
# THRESH_RULE_CONFIDENCE=0.95        # confidence of a positive template match
# THRESH_RULES_GENERIC_CONFIDENCE=0.7# confidence when no template matched
# THRESH_PARSE_MIN_CONFIDENCE=0.0    # semantic-parse slots below this are dropped
# THRESH_ANSWER_MAX_CHARS=160        # a longer answer is truncated for comparison
# THRESH_GROUNDING_MIN_CHARS=2       # minimum length of a span that counts as evidence
# THRESH_ROUTER_MIN_CONFIDENCE=0.65  # router escalates below its own confidence
# THRESH_CONFLICT_ACCEPT_CONFIDENCE=0.8 # Round 2: confidence a conflicted fact keeps

# === Ablation switches (measurement only - never a default) ===
# ABLATE_CLASSIFIER=1 removes the template classifier *and* the template slot
#   parser everywhere: the run measures the system under phrasing it was never
#   tuned on (row D of the generalisation suite).
# ABLATE_ROUTER=1 bypasses capability routing: every question escalates to the
#   most capable arm, so the router's own contribution (accuracy *and* cost) can
#   be separated from the arm it routes to (row E).

