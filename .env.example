# Agentic GraphRAG Hackathon — Environment Configuration
# Copy this file to .env and fill in your values

# === TigerGraph (optional graph backend; unset = the local JSON graph) ===
# TG_ENABLED=true makes the agent's graph tools answer from TigerGraph; the
# corpus-built local graph is still kept as a mirror, every remote answer is
# verified against it, and any outage degrades back to it with a printed reason.
#   python tools/tg_ingest.py --status           # what the server has now
#   python tools/tg_ingest.py --install --push   # schema + queries + corpus graph
# Offline (no TigerGraph install): python tools/tg_fake_server.py --port 19123
TG_ENABLED=
# Cloud (Savanna) form - the GSQL port is closed there, use tools/tg_ingest.py --print
TG_HOST=https://YOUR_INSTANCE.i.tgcloud.io
TG_GRAPHNAME=OlympicsKG
TG_USERNAME=tigergraph
TG_PASSWORD=tigergraph
TG_RESTPP_PORT=443
TG_GS_PORT=443
# Community Edition form: TG_HOST=http://localhost TG_RESTPP_PORT=9000 TG_GS_PORT=14240
# Optional:
TG_TOKEN=
# Row budget per query - a safety valve, NOT a tuning knob. The corpus's largest
# candidate set is 2210 rows (probe: python tools/probe_tg_semantics.py); a budget
# below it turns into a loud "row budget" note instead of silent truncation.
TG_MAX_ROWS=100000
TG_TIMEOUT=30
TG_RETRIES=2


# === LLM Provider: Groq ===
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_YOUR_KEY_HERE

# === Rate limiting (important for long benchmark runs) ===
# Free/on-demand tiers return HTTP 429 when pushed. Instead of retry-thrashing,
# we pace request starts client-side. 1.5s ≈ 40 requests/min; 0 disables pacing.
LLM_MIN_INTERVAL_S=1.5
# Hard caps so one unlucky call can never stall a whole run.
LLM_MAX_BACKOFF_S=20
LLM_MAX_CALL_S=90
# Token budget per minute. Groq's free tier meters TOKENS (gpt-oss-120b:
# 30 RPM, 1K RPD, 8K TPM, 200K TPD). The ReAct agent re-sends the system prompt
# plus tool schemas (~1.4k tokens) on every step, so the token budget, not the
# request count, is what binds. 0 disables token pacing.
LLM_TPM=8000
LLM_OUTPUT_RESERVE=250
# Circuit breaker: after N consecutive 429s the provider is skipped entirely and
# the deterministic layer finishes the question instead of stalling the run.
LLM_CIRCUIT_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_S=60

# === Agentic loop ===
# AGENT_MODE: react  = the LLM drives every step via native tool calls
#             hybrid = the LLM drives; deterministic solvers rescue empty answers
#             plan   = deterministic planner/executor only
AGENT_MODE=hybrid
AGENT_REACT_MAX_STEPS=6
AGENT_REACT_RETRIES=2
AGENT_MAX_STEPS=15
AGENT_CONFIDENCE_THRESHOLD=0.9
AGENT_STALE_STEP_LIMIT=2
AGENT_MAX_WIDEN_ATTEMPTS=2
# Final-answer arbitration: when the tool loop's answer disagrees with a
# structure-verified candidate (complete candidate set for counting/argmax,
# resolution confidence above the per-type threshold otherwise), the verified
# candidate wins. Same definition of "verified" the RAG/GraphRAG arms use.
# true  = accuracy-maximising (default)
# false = LLM-first, guards only (the agent's answer is kept)
AGENT_STRUCTURED_PREFERENCE=true

# === Ablation arm ===
# true  = also run 'RAG (vector only)': the RAG pipeline with the
#         structure-aware retrieval step disabled, so the dashboard can show
#         what that layer contributes separately from the graph.
# false = the three main pipelines only (default)
ABLATION_RAG=false

# === Model Selection (Groq) ===
# Available on a standard Groq key: openai/gpt-oss-120b, openai/gpt-oss-20b,
# qwen/qwen3.8-27b, groq/compound. Check with: python tools/probe_llm.py <key>
COMPLETION_MODEL=openai/gpt-oss-120b
CHAT_MODEL=openai/gpt-oss-120b
EVAL_MODEL=openai/gpt-oss-120b
FAST_MODEL=openai/gpt-oss-20b

# Generation budget — gpt-oss models spend reasoning tokens, so cap the output
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=900
LLM_REASONING_EFFORT=low

# === Local Embeddings (sentence-transformers on GPU) ===
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cuda

# === Paths ===
CORPUS_PATH=corpus-20260919T043338Z-1-001/corpus/corpus.jsonl
PUBLIC_QUESTIONS_PATH=questions-20260919T043312Z-1-001/questions/eval_public.jsonl
HIDDEN_QUESTIONS_PATH=questions-20260919T043312Z-1-001/questions/eval_hidden.jsonl
